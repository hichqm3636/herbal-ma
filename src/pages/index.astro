---
import LocaleLayout from "../layouts/LocaleLayout.astro";
import { getLocaleRoot } from "../lib/locales";
import { getAbsoluteSiteUrl, type SeoAlternate } from "../lib/seo";

const canonical = getAbsoluteSiteUrl("/", Astro.site);
const alternates: SeoAlternate[] = [
  {
    hreflang: "ar",
    href: getAbsoluteSiteUrl(getLocaleRoot("ar"), Astro.site),
  },
  {
    hreflang: "en",
    href: getAbsoluteSiteUrl(getLocaleRoot("en"), Astro.site),
  },
  {
    hreflang: "x-default",
    href: canonical,
  },
];
---

<LocaleLayout
  locale="ar"
  title="Herbal.ma"
  description="Herbal.ma منصة معرفية تعليمية مستقلة بالعربية والإنجليزية. اختر اللغة للمتابعة."
  canonical={canonical}
  alternates={alternates}
>
  <main class="language-gateway">
    <section class="language-gateway__panel">
      <h1>Herbal.ma</h1>
      <p class="language-gateway__prompt">اختر اللغة.</p>
      <p class="language-gateway__choice">
        <a href="/ar/">العربية</a>
      </p>
      <p class="language-gateway__prompt" lang="en" dir="ltr">
        Choose a language.
      </p>
      <p class="language-gateway__choice" lang="en" dir="ltr">
        <a href="/en/">English</a>
      </p>
    </section>
  </main>
</LocaleLayout>
