---
import {
  getLocaleDirection,
  getOtherLocale,
  type Locale,
} from "../lib/locales";
import type { CollectionIndexPath, SearchPath } from "../lib/routes";

interface Props {
  currentLocale: Locale;
  targetPath: CollectionIndexPath | SearchPath | "/ar/" | "/en/";
}

const { currentLocale, targetPath } = Astro.props;
const otherLocale = getOtherLocale(currentLocale);
const otherDirection = getLocaleDirection(otherLocale);
const copy = {
  ar: {
    label: "اللغة",
    link: "English",
  },
  en: {
    label: "Language",
    link: "العربية",
  },
}[currentLocale];
---

<nav class="locale-navigation" aria-label={copy.label}>
  <a
    class="locale-navigation__link"
    href={targetPath}
    lang={otherLocale}
    dir={otherDirection}
  >
    {copy.link}
  </a>
</nav>
