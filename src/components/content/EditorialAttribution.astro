---
import { type PublicAttribution } from "../../lib/content-access";
import { type Locale } from "../../lib/locales";

interface Props {
  locale: Locale;
  authors: PublicAttribution[];
  reviewers?: PublicAttribution[];
  publishedAt: string;
  updatedAt?: string;
  lastReviewedAt?: string;
}

const {
  locale,
  authors,
  reviewers = [],
  publishedAt,
  updatedAt,
  lastReviewedAt,
} = Astro.props;

const labels =
  locale === "ar"
    ? {
        authors: "الكتّاب",
        reviewers: "المراجعون",
        published: "تاريخ النشر",
        updated: "تاريخ التحديث",
        lastReviewed: "تاريخ آخر مراجعة",
      }
    : {
        authors: "Authors",
        reviewers: "Reviewers",
        published: "Published",
        updated: "Updated",
        lastReviewed: "Last reviewed",
      };

function formatUtcDate(value: string): string {
  return new Intl.DateTimeFormat(locale, {
    dateStyle: "long",
    timeZone: "UTC",
  }).format(new Date(value));
}
---

<section>
  <h2>{labels.authors}</h2>
  <ul>
    {authors.map((author) => (
      <li>
        <p>{author.displayName}</p>
        {author.role && <p>{author.role}</p>}
        {author.qualifications && author.qualifications.length > 0 && (
          <ul>
            {author.qualifications.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )}
        {author.disclosures && author.disclosures.length > 0 && (
          <ul>
            {author.disclosures.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ul>

  {reviewers.length > 0 && (
    <>
      <h2>{labels.reviewers}</h2>
      <ul>
        {reviewers.map((reviewer) => (
          <li>
            <p>{reviewer.displayName}</p>
            {reviewer.role && <p>{reviewer.role}</p>}
            {reviewer.qualifications && reviewer.qualifications.length > 0 && (
              <ul>
                {reviewer.qualifications.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
            {reviewer.disclosures && reviewer.disclosures.length > 0 && (
              <ul>
                {reviewer.disclosures.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </>
  )}

  <p>
    {labels.published}{" "}
    <time datetime={publishedAt}>{formatUtcDate(publishedAt)}</time>
  </p>
  {updatedAt && (
    <p>
      {labels.updated}{" "}
      <time datetime={updatedAt}>{formatUtcDate(updatedAt)}</time>
    </p>
  )}
  {lastReviewedAt && (
    <p>
      {labels.lastReviewed}{" "}
      <time datetime={lastReviewedAt}>{formatUtcDate(lastReviewedAt)}</time>
    </p>
  )}
</section>
