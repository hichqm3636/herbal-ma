---
import type { CollectionEntry } from "astro:content";
import { getOtherLocale } from "../../lib/locales";
import {
  getPublicEntryPath,
  getPublicPublishedAt,
  getPublicTranslationCounterpart,
  renderPublicArticleBody,
  resolvePublicAttribution,
  resolvePublicCitations,
  resolvePublicReferences,
} from "../../lib/content-access";
import {
  buildArticleStructuredData,
  getAbsolutePublicEntryUrl,
  getPublicHreflangLinks,
  getSeoModifiedAt,
  serializeJsonLd,
} from "../../lib/seo";
import ContentPageLayout from "../../layouts/ContentPageLayout.astro";
import EditorialAttribution from "./EditorialAttribution.astro";
import ReferencesList from "./ReferencesList.astro";

interface Props {
  entry: CollectionEntry<"articles">;
}

const { entry } = Astro.props;
const locale = entry.data.locale;
const publishedAt = getPublicPublishedAt(entry);
const authors = await resolvePublicAttribution(entry.data.authors, locale);
const reviewers = await resolvePublicAttribution(entry.data.reviewers, locale);
const categories = await resolvePublicReferences(
  "categories",
  locale,
  entry.data.categories,
);
const ingredients = await resolvePublicReferences(
  "ingredients",
  locale,
  entry.data.ingredients,
);
const relatedArticles = await resolvePublicReferences(
  "articles",
  locale,
  entry.data.relatedArticles,
);
const citations = await resolvePublicCitations(entry.data.sources);
const { Content } = await renderPublicArticleBody(entry);
const counterpart = await getPublicTranslationCounterpart(
  "articles",
  entry,
  getOtherLocale(locale),
);
const counterpartHref = counterpart
  ? getPublicEntryPath(counterpart)
  : undefined;
const canonical = getAbsolutePublicEntryUrl(entry, Astro.site);
const alternates = getPublicHreflangLinks(entry, counterpart, Astro.site);
const jsonLd = serializeJsonLd(
  buildArticleStructuredData({
    headline: entry.data.title,
    description: entry.data.summary,
    url: canonical,
    datePublished: publishedAt,
    dateModified: getSeoModifiedAt(entry),
    inLanguage: locale,
    authorNames: authors.map((author) => author.displayName),
  }),
);

const copy = {
  ar: {
    commercialDisclosure: "إفصاح تجاري",
    categories: "التصنيفات",
    ingredients: "المكوّنات",
    relatedArticles: "مقالات ذات صلة",
  },
  en: {
    commercialDisclosure: "Commercial disclosure",
    categories: "Categories",
    ingredients: "Ingredients",
    relatedArticles: "Related articles",
  },
}[locale];
---

<ContentPageLayout
  locale={locale}
  title={`${entry.data.title} — Herbal.ma`}
  heading={entry.data.title}
  summary={entry.data.summary}
  needsUpdate={entry.data.status === "needs-update"}
  counterpartHref={counterpartHref}
  description={entry.data.summary}
  canonical={canonical}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <EditorialAttribution
    locale={locale}
    authors={authors}
    reviewers={reviewers}
    publishedAt={publishedAt}
    updatedAt={entry.data.updatedAt}
    lastReviewedAt={entry.data.lastReviewedAt}
  />

  {entry.data.commercialDisclosure && (
    <section>
      <h2>{copy.commercialDisclosure}</h2>
      <p>{entry.data.commercialDisclosure}</p>
    </section>
  )}

  <section>
    <Content />
  </section>

  {categories.length > 0 && (
    <section>
      <h2>{copy.categories}</h2>
      <ul>
        {categories.map((category) => (
          <li>
            <a href={getPublicEntryPath(category)}>{category.data.name}</a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {ingredients.length > 0 && (
    <section>
      <h2>{copy.ingredients}</h2>
      <ul>
        {ingredients.map((ingredient) => (
          <li>
            <a href={getPublicEntryPath(ingredient)}>{ingredient.data.name}</a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {relatedArticles.length > 0 && (
    <section>
      <h2>{copy.relatedArticles}</h2>
      <ul>
        {relatedArticles.map((relatedArticle) => (
          <li>
            <a href={getPublicEntryPath(relatedArticle)}>
              {relatedArticle.data.title}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <ReferencesList locale={locale} citations={citations} />
</ContentPageLayout>
