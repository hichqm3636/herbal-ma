---
import type { LocalizedCollection } from "../lib/content-access";
import type { Locale } from "../lib/locales";
import { getLocaleRoot } from "../lib/locales";
import { getCollectionIndexPath, getSearchPath } from "../lib/routes";

export type SiteNavigationCurrent = "home" | LocalizedCollection | "search";

interface Props {
  locale: Locale;
  current?: SiteNavigationCurrent;
}

const { locale, current } = Astro.props;

const copy = {
  ar: {
    label: "التنقل في الموقع",
    home: "الرئيسية",
    articles: "المقالات",
    ingredients: "المكوّنات",
    categories: "التصنيفات",
    search: "بحث",
  },
  en: {
    label: "Site navigation",
    home: "Home",
    articles: "Articles",
    ingredients: "Ingredients",
    categories: "Categories",
    search: "Search",
  },
}[locale];

const items = [
  {
    id: "home" as const,
    href: getLocaleRoot(locale),
    label: copy.home,
  },
  {
    id: "articles" as const,
    href: getCollectionIndexPath("articles", locale),
    label: copy.articles,
  },
  {
    id: "ingredients" as const,
    href: getCollectionIndexPath("ingredients", locale),
    label: copy.ingredients,
  },
  {
    id: "categories" as const,
    href: getCollectionIndexPath("categories", locale),
    label: copy.categories,
  },
  {
    id: "search" as const,
    href: getSearchPath(locale),
    label: copy.search,
  },
];
---

<nav class="site-navigation" aria-label={copy.label}>
  <ul class="site-navigation__list">
    {items.map((item) => (
      <li>
        <a
          class="site-navigation__link"
          href={item.href}
          aria-current={current === item.id ? "page" : undefined}
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
