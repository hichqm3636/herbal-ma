---
import {
  getLocaleDirection,
  getLocaleRoot,
  getOtherLocale,
  type Locale,
} from "../lib/locales";
import type {
  LocalizedCollection,
  PublicEntryPath,
} from "../lib/content-access";
import type { SeoMetadata } from "../lib/seo";
import { getCollectionIndexPath } from "../lib/routes";
import LocaleLayout from "./LocaleLayout.astro";
import SiteNavigation from "../components/SiteNavigation.astro";

interface Props extends SeoMetadata {
  locale: Locale;
  collection: LocalizedCollection;
  title: string;
  heading: string;
  summary: string;
  needsUpdate?: boolean;
  counterpartHref?: PublicEntryPath;
}

const {
  locale,
  collection,
  title,
  heading,
  summary,
  needsUpdate,
  counterpartHref,
  description,
  canonical,
  alternates,
  robots,
  jsonLd,
} = Astro.props;
const counterpartLocale = getOtherLocale(locale);
const counterpartDirection = getLocaleDirection(counterpartLocale);
const copy = {
  ar: {
    needsUpdate: "هذه الصفحة معلّمة بأنها تحتاج تحديثا.",
    counterpartName: "English",
    counterpartUnavailable: "غير متاحة",
    breadcrumb: "مسار التنقل",
    home: "الرئيسية",
    articles: "المقالات",
    ingredients: "المكوّنات",
    categories: "التصنيفات",
  },
  en: {
    needsUpdate: "This page is marked as needing an update.",
    counterpartName: "العربية",
    counterpartUnavailable: "unavailable",
    breadcrumb: "Breadcrumb",
    home: "Home",
    articles: "Articles",
    ingredients: "Ingredients",
    categories: "Categories",
  },
}[locale];
const homeHref = getLocaleRoot(locale);
const collectionHref = getCollectionIndexPath(collection, locale);
const collectionLabel = copy[collection];
---

<LocaleLayout
  locale={locale}
  title={title}
  description={description}
  canonical={canonical}
  alternates={alternates}
  robots={robots}
  jsonLd={jsonLd}
>
  <SiteNavigation locale={locale} />
  <main>
    <nav aria-label={copy.breadcrumb}>
      <ol>
        <li>
          <a href={homeHref}>{copy.home}</a>
        </li>
        <li>
          <a href={collectionHref}>{collectionLabel}</a>
        </li>
        <li aria-current="page">{heading}</li>
      </ol>
    </nav>
    <article>
      <header>
        <h1>{heading}</h1>
        <p>{summary}</p>
        {needsUpdate && (
          <p>
            <strong>{copy.needsUpdate}</strong>
          </p>
        )}
        <p>
          {counterpartHref ? (
            <a
              href={counterpartHref}
              lang={counterpartLocale}
              dir={counterpartDirection}
            >
              {copy.counterpartName}
            </a>
          ) : (
            <>
              <span lang={counterpartLocale} dir={counterpartDirection}>
                {copy.counterpartName}
              </span>
              {" — "}
              {copy.counterpartUnavailable}
            </>
          )}
        </p>
      </header>
      <slot />
    </article>
  </main>
</LocaleLayout>

<style>
  main {
    max-inline-size: 40rem;
    margin-inline: auto;
    padding: 1rem;
    line-height: 1.6;
  }

  nav ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
  }

  nav li[aria-current="page"] {
    font-weight: 700;
  }
</style>
